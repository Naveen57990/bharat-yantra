{
  "name": "bharat-yantra-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-cesium-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-cesium-assets.mjs",
    "build": "tsc --noEmit && vite build",
